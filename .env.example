APP_NAME=Silver Bridge API
ENV=local
DEBUG=true

# Railway 배포 시 Postgres 플러그인이 DATABASE_URL을 자동 주입함 (로컬 개발용 기본값)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/silverbridge

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

OPENAI_API_KEY=
NAVER_CLOVA_CLIENT_ID=
NAVER_CLOVA_CLIENT_SECRET=

LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 배포 후엔 Railway가 발급한 도메인으로 교체 (Twilio webhook/콜백 URL 생성에 사용)
PUBLIC_BASE_URL=http://localhost:8000

# 주민등록번호/계좌번호 암호화 키. 배포 환경에서는 반드시 새로 발급해서 교체할 것
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
